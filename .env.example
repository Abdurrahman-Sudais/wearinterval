# Copy to .env.local. All variables are optional.
# Without them, the early-access form saves enquiries in the browser and offers a pre-filled email.

# HubSpot Forms API (https://api.hsforms.com/submissions/v3/integration/submit/<portal>/<form>)
# VITE_HUBSPOT_PORTAL_ID=
# VITE_HUBSPOT_FORM_GUID=
# Subscription type id for the optional "product updates" checkbox
# VITE_HUBSPOT_MARKETING_SUBSCRIPTION_ID=
